APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Multi-Platform Social Automation
SOCIAL_USE_NEW_PIPELINE=true
SOCIAL_CIRCUIT_FAILURE_THRESHOLD=5
SOCIAL_CIRCUIT_COOLDOWN_SECONDS=120
SOCIAL_LOG_RETENTION_DAYS=30
SOCIAL_WEBHOOK_RETENTION_DAYS=60

# Meta (Facebook & Instagram)
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v21.0
META_WEBHOOK_VERIFY_TOKEN=fb-automation-verify-token
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URI="${APP_URL}/oauth/facebook/callback"
FACEBOOK_WEBHOOK_VERIFY_TOKEN=fb-automation-verify-token
FACEBOOK_GRAPH_VERSION=v21.0
FACEBOOK_RATE_LIMIT_HOURLY=180
FACEBOOK_USAGE_THRESHOLD_PERCENT=80
INSTAGRAM_REDIRECT_URI="${APP_URL}/social/accounts/oauth/instagram/callback"

# Threads
THREADS_APP_ID=
THREADS_APP_SECRET=
THREADS_REDIRECT_URI="${APP_URL}/social/accounts/oauth/threads/callback"
THREADS_API_VERSION=v1.0
THREADS_BASE_URL=https://graph.threads.net

# LinkedIn
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI="${APP_URL}/social/accounts/oauth/linkedin/callback"
LINKEDIN_API_VERSION=202501
LINKEDIN_BASE_URL=https://api.linkedin.com

# YouTube (Google OAuth)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI="${APP_URL}/social/accounts/oauth/youtube/callback"
YOUTUBE_BASE_URL=https://www.googleapis.com
YOUTUBE_DAILY_QUOTA=10000

# X (Twitter)
X_PROVIDER_ENABLED=false
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI="${APP_URL}/social/accounts/oauth/x/callback"

# TikTok
TIKTOK_PROVIDER_ENABLED=false
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI="${APP_URL}/social/accounts/oauth/tiktok/callback"

# Pinterest
PINTEREST_PROVIDER_ENABLED=false
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
PINTEREST_REDIRECT_URI="${APP_URL}/social/accounts/oauth/pinterest/callback"
